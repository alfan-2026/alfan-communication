#!/usr/bin/python3.10
import socket
import time

# Konfigurasi
RASPI2_IP = "192.168.4.2"  # IP Raspi 2
READ_PORT  = 5001         # Port yang dipakai Raspi 1 untuk menerima data dari Raspi 2
WRITE_PORT = 5000         # Port yang dipakai Raspi 1 untuk mengirim data ke Raspi 2

# File log state (dideklarasikan dari awal)
STATE_RASPI1_FILE = "/home/pi/communication/state_raspi1.txt"  # Log state Raspi 1 (sumber data untuk write)
STATE_RASPI2_FILE = "/home/pi/communication/state_raspi2.txt"  # Log state Raspi 2 (hasil dari read)

def read_data_from_raspi2():
    """
    Menghubungkan ke Raspi 2 dan membaca data integer yang dikirim,
    kemudian menulis ulang (flush and write) ke file STATE_RASPI2_FILE.
    """
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            s.connect((RASPI2_IP, WRITE_PORT))
            data = s.recv(1024).decode().strip()
            # Konversi data ke integer
            int_data = int(data)
            # Tulis ulang data ke file (replace)
            with open(STATE_RASPI2_FILE, "w") as f:
                f.write(str(int_data))
            print("Raspi 1: Terbaca integer", int_data, "dari Raspi 2; file log state Raspi 2 diupdate.")
            return int_data
    except Exception as e:
        print("Raspi 1: Error membaca data dari Raspi 2:", e)
        return None

def write_data_to_raspi2():
    """
    Membaca data integer dari file STATE_RASPI1_FILE,
    kemudian mengirimkannya ke Raspi 2.
    """
    try:
        with open(STATE_RASPI1_FILE, "r") as f:
            data = f.read().strip()
            int_data = int(data)
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            s.connect((RASPI2_IP, READ_PORT))
            s.sendall(str(int_data).encode())
        print("Raspi 1: Mengirim integer", int_data, "ke Raspi 2.")
        return True
    except Exception as e:
        print("Raspi 1: Error menulis data ke Raspi 2:", e)
        return False

def check_wifi_raspi2(timeout=3):
    """
    Memeriksa apakah Raspi 2 terdeteksi (berhasil connect) dengan mencoba
    membuka koneksi ke Raspi 2 pada port WRITE_PORT.
    """
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            s.settimeout(timeout)
            s.connect((RASPI2_IP, WRITE_PORT))
        print("Raspi 1: Raspi 2 terdeteksi (wifi connect OK).")
        return True
    except Exception:
        print("Raspi 1: Raspi 2 tidak terdeteksi (wifi connect gagal).")
        return False

# Contoh penggunaan fungsi-fungsi di atas
if __name__ == "__main__":
    # Misalnya, cek koneksi dulu
    if check_wifi_raspi2():
        # Baca data dari Raspi 2 dan simpan ke file log state Raspi 2
        read_data_from_raspi2()
        # Kirim data dari file log state Raspi 1 ke Raspi 2
        write_data_to_raspi2()
    else:
        print("Raspi 1: Tidak dapat terhubung ke Raspi 2, cek koneksi Wi-Fi.")
