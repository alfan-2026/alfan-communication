                send_message("Data dari Raspi 1", TARGET_IP, SEND_PORT)
                time.sleep(0.5)  # Delay 500 ms antar pengiriman
                # Periksa apakah pesan yang diharapkan ada di queue
                while not recv_queue.empty():
                    msg = recv_queue.get()
                    if msg == "ACK dari Raspi 2":
                        print("Raspi 1: ACK diterima dari Raspi 2, pindah ke State 2.")
                        ack_received = True
                    else:
                        print(f"Raspi 1: Pesan tidak terduga: {msg}")
            time.sleep(0.01)  # Delay 10 ms
            state = 2

        elif state == 2:
            # --- State 2: Raspi 1 menunggu "Data dari Raspi 2" lalu mengirim ACK ---
            data_received = False
            while not data_received:
                while not recv_queue.empty():
                    msg = recv_queue.get()
                    if msg == "Data dari Raspi 2":
                        print("Raspi 1: Data dari Raspi 2 diterima, mengirim ACK.")
                        data_received = True
                    else:
                        print(f"Raspi 1: Pesan tidak terduga: {msg}")
                if not data_received:
                    print("Raspi 1: Menunggu Data dari Raspi 2...")
                    time.sleep(0.5)
            send_message("ACK dari Raspi 1", TARGET_IP, SEND_PORT)
            time.sleep(0.01)
            state = 1
