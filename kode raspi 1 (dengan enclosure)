#!/usr/bin/python3.10
import socket
import time
import threading
from queue import Queue

# Konfigurasi Raspi 1
SEND_PORT = 5000      # Mengirim ke Raspi 2
RECEIVE_PORT = 5001   # Menerima dari Raspi 2
TARGET_IP = "192.168.4.2"

# Queue untuk menyimpan pesan yang diterima
recv_queue = Queue()

def receiver_thread():
    """Thread untuk menerima pesan secara terus-menerus."""
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as server_sock:
        server_sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        server_sock.bind(("0.0.0.0", RECEIVE_PORT))
        server_sock.listen(5)
        while True:
            try:
                conn, addr = server_sock.accept()
                with conn:
                    data = conn.recv(1024)
                    if data:
                        msg = data.decode().strip()
                        print(f"[Raspi 1 Receiver] Diterima: {msg}")
                        recv_queue.put(msg)
            except Exception as e:
                # Bila terjadi error, lanjutkan saja
                continue

def send_message(message, target_ip, port):
    """Mengirim pesan ke target; kembalikan True jika sukses."""
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            s.connect((target_ip, port))
            s.sendall(message.encode())
            print(f"Raspi 1 terkirim: {message}")
            return True
    except Exception:
        return False

if __name__ == "__main__":
    # Mulai receiver thread (daemon supaya otomatis berhenti saat program utama selesai)
    threading.Thread(target=receiver_thread, daemon=True).start()
    
    state = 1  # Mulai dari State 1
    while True:
        if state == 1:
            # --- State 1: Raspi 1 mengirim "Data dari Raspi 1" hingga mendapat "ACK dari Raspi 2" ---
            ack_received = False
