                while not recv_queue.empty():
                    msg = recv_queue.get()
                    if msg == "Data dari Raspi 1":
                        print("Raspi 2: Data dari Raspi 1 diterima, mengirim ACK.")
                        data_received = True
                    else:
                        print(f"Raspi 2: Pesan tidak terduga: {msg}")
                if not data_received:
                    print("Raspi 2: Menunggu Data dari Raspi 1...")
                    time.sleep(0.5)
            send_message("ACK dari Raspi 2", TARGET_IP, SEND_PORT)
            time.sleep(1)  # Delay 1 detik agar Raspi 1 sempat berpindah state
            state = 2

