#!/usr/bin/python3.10
import socket
import time
import threading
from queue import Queue

# Konfigurasi Raspi 2
SEND_PORT = 5001      # Mengirim ke Raspi 1
RECEIVE_PORT = 5000   # Menerima dari Raspi 1
TARGET_IP = "192.168.4.1"

recv_queue = Queue()

def receiver_thread():
    """Thread untuk menerima pesan secara terus-menerus."""
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as server_sock:
        server_sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        server_sock.bind(("0.0.0.0", RECEIVE_PORT))
        server_sock.listen(5)
        while True:
            try:
                conn, addr = server_sock.accept()
                with conn:
                    data = conn.recv(1024)
                    if data:
                        msg = data.decode().strip()
                        print(f"[Raspi 2 Receiver] Diterima: {msg}")
                        recv_queue.put(msg)
            except Exception:
                continue

def send_message(message, target_ip, port):
    """Mengirim pesan ke target; kembalikan True jika sukses."""
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            s.connect((target_ip, port))
            s.sendall(message.encode())
            print(f"Raspi 2 terkirim: {message}")
            return True
    except Exception:
        return False

